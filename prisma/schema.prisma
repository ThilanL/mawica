generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CardStatus {
  PUBLISHED
  REMOVED
  /// Created through scheduling and not yet delivered: never publicly visible (every public guard requires PUBLISHED).
  SCHEDULED
  /// A scheduled card whose schedule was cancelled before delivery: never visible, never published.
  CANCELLED
}

enum ReportReason {
  INAPPROPRIATE
  HARASSMENT
  SPAM
  OTHER
}

/// A published, personalised card. Template content lives in code (src/modules/templates).
model Card {
  id            String     @id @default(uuid()) @db.Uuid
  slug          String     @unique @db.VarChar(16)
  templateKey   String     @db.VarChar(40)
  recipientName String     @db.VarChar(40)
  senderName    String     @db.VarChar(40)
  message       String     @db.VarChar(500)
  status        CardStatus @default(PUBLISHED)
  createdAt     DateTime   @default(now())
  removedAt     DateTime?
  removedReason String?    @db.VarChar(200)
  reports       Report[]
  /// Nullable on purpose: historical and guest cards have no owner and are never auto-assigned one.
  /// SetNull (not Cascade/Restrict) so deleting an account can never delete or block public cards by accident;
  /// what happens to a deleted user's cards is an open product decision (docs/accounts.md).
  ownerId       String?    @db.Uuid
  owner         User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Resolved on the server from the template registry at publish time (never from the client); a snapshot, so
  /// reclassifying a template later does not rewrite history. Every existing card is STANDARD.
  tier          CardTier   @default(STANDARD)
  /// Curated soundtrack id from src/modules/music/catalogue (including "none"). Null = legacy card published before
  /// music existed; resolved at read time (Christmas → snowlight-on-the-sleigh-path). Explicit "none" is silence.
  /// Never an external URL. New publishes always store an explicit value.
  musicTrackId  String?    @db.VarChar(40)
  scheduledDelivery ScheduledDelivery?
  media         CardMedia?

  @@index([status, createdAt])
  @@index([ownerId])
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  cardId       String       @db.Uuid
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  reason       ReportReason
  details      String?      @db.VarChar(300)
  /// HMAC of the reporter IP, never the raw address.
  reporterHash String       @db.VarChar(64)
  createdAt    DateTime     @default(now())

  @@index([cardId])
}

/// Fixed-window counters keyed by HMAC(ip + scope). Rows expire and are purged (see rate-limit.ts).
model RateLimit {
  key         String   @id @db.VarChar(80)
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

// ============================ Accounts (Better Auth 1.7.19) ============================
// Table/column shapes for User, Session, Account, Verification and AuthRateLimit come from the Better Auth CLI
// (`npx auth@1.7.19 generate`, see docs/accounts.md). Deliberate edits: Timestamptz(3) on every timestamp, and the
// rate-limit model is renamed AuthRateLimit so it can never merge into Mawica's own RateLimit table.

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  settings      AccountSettings?
  cards         Card[]
  auditLogs     AuditLog[]
  creditAccount CreditAccount?
  recipients    Recipient[]
  scheduledDeliveries ScheduledDelivery[]
  reminderPreference ReminderPreference?
  cardMedia     CardMedia[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model AuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("authRateLimit")
}

// ---- Mawica-owned account data ----

model Profile {
  userId          String    @id @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String?   @db.VarChar(40)
  /// IANA zone id, validated server-side. Used later for scheduling; UTC until the user chooses.
  timeZone        String    @default("UTC") @db.VarChar(64)
  /// Time the sign-in notice (Terms and Privacy links) was shown and accepted by continuing. Not a legal-consent record.
  termsAcceptedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

/// Preferences with safe defaults. Nothing reads these yet (reminders arrive with scheduling).
model AccountSettings {
  userId         String   @id @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderEmails Boolean  @default(true)
  productNews    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

/// Append-only in spirit: application code only inserts. Never store emails, codes, tokens or message text in meta.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Staff actor for admin.mawica.com actions (separate from consumer User).
  staffPrincipalId String? @db.Uuid
  staffPrincipal   StaffPrincipal? @relation(fields: [staffPrincipalId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(60)
  meta      Json?
  /// HMAC of the client IP (same keyed hash scheme as rate limits), never the raw address.
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([staffPrincipalId, createdAt])
  @@index([action, createdAt])
}

/// Staff roles for admin.mawica.com (server-side RBAC). Not used by the consumer app.
enum StaffRole {
  OWNER
  MODERATOR
  SUPPORT
  FINANCE
  OPS
  READONLY
}

/// Staff identity linked to Microsoft Entra ID (oid). Seeded/updated on successful admin sign-in.
model StaffPrincipal {
  id          String    @id @default(uuid()) @db.Uuid
  /// Entra object id (oid claim). Stable across email changes.
  entraOid    String    @unique @db.VarChar(64)
  email       String    @db.VarChar(320)
  displayName String    @db.VarChar(120)
  role        StaffRole
  disabledAt  DateTime? @db.Timestamptz(3)
  lastSeenAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  auditLogs   AuditLog[]
  cmsDocumentsUpdated CmsDocument[] @relation("CmsDocumentUpdatedBy")
  cmsRevisionsPublished CmsRevision[] @relation("CmsRevisionPublishedBy")
  cmsMarketingAssetsUploaded CmsMarketingAsset[] @relation("CmsMarketingAssetUploadedBy")

  @@index([email])
  @@index([role, disabledAt])
}

// ============================ Card wallet (Phase 2B.2) ============================
// Design proven in the isolated spike (docs/wallet.md). Balances live in CreditGrant.remaining, guarded by CHECK
// constraints and updated only by conditional decrements inside a transaction; LedgerEntry is the append-only audit.
// All timestamps are timestamptz and the app connects in UTC (see src/lib/db.ts).

enum CardTier {
  STANDARD
  PREMIUM
}

enum EntitlementPeriod {
  NONE
  MONTH
  SUBSCRIPTION_YEAR
  LIFETIME
  EVENT
}

enum GrantUnit {
  TOTAL
  PREMIUM
}

enum GrantSource {
  WELCOME
  PLAN_PERIOD
  PURCHASE
  ADJUSTMENT
}

enum LedgerKind {
  GRANT
  RESERVE
  COMMIT
  RELEASE
  EXPIRE
  REFUND
  ADJUST
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
}

/// Plans are data. Corporate, Unlimited and Event are future rows (periods SUBSCRIPTION_YEAR / EVENT already exist).
model Plan {
  key          String            @id @db.VarChar(40)
  name         String            @db.VarChar(80)
  active       Boolean           @default(true)
  /// False until the payments phase: no client or API can put an account on a non-purchasable plan.
  purchasable  Boolean           @default(false)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  entitlements PlanEntitlement[]
  accounts     CreditAccount[]
}

/// key is one of: sends.total, sends.premium, welcome.premium, schedule.months_ahead (value NULL = unlimited, fair use applies).
model PlanEntitlement {
  planKey String            @db.VarChar(40)
  plan    Plan              @relation(fields: [planKey], references: [key], onDelete: Cascade)
  key     String            @db.VarChar(60)
  value   Int?
  period  EntitlementPeriod

  @@id([planKey, key])
}

model CreditAccount {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SetNull: deleting a user keeps the ledger (anonymised); the welcome tombstone is what stops a second gift.
  userId       String?             @unique @db.Uuid
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  planKey      String              @default("free") @db.VarChar(40)
  plan         Plan                @relation(fields: [planKey], references: [key])
  /// Fixed instant that anchors monthly periods (the account anniversary). Never changes.
  periodAnchor DateTime            @default(now()) @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  grants       CreditGrant[]
  reservations CreditReservation[]
  ledger       LedgerEntry[]
}

model CreditGrant {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String        @db.Uuid
  account   CreditAccount @relation(fields: [accountId], references: [id])
  unit      GrantUnit
  source    GrantSource
  /// Deterministic per logical grant ("welcome", "period:free:<start>:TOTAL", "purchase:<order>"), unique per account:
  /// retries are idempotent and many legitimate grants of one source can coexist.
  grantKey  String        @db.VarChar(100)
  amount    Int
  remaining Int
  validFrom DateTime      @db.Timestamptz(3)
  /// NULL = never expires (welcome gift).
  validTo   DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  ledger    LedgerEntry[]

  @@unique([accountId, grantKey])
  @@index([accountId, unit, validTo])
}

model CreditReservation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String            @db.Uuid
  account        CreditAccount     @relation(fields: [accountId], references: [id])
  idempotencyKey String            @db.VarChar(64)
  /// sha256 of the canonical request: same key + different hash is a client bug, refused.
  requestHash    String            @db.VarChar(64)
  status         ReservationStatus @default(HELD)
  premium        Boolean
  /// Plain id (no FK) on purpose: settled reservations are immutable, so a referential action must never need to update them.
  cardId         String?           @unique @db.Uuid
  deliverAt      DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  settledAt      DateTime?         @db.Timestamptz(3)
  ledger         LedgerEntry[]
  scheduledDelivery ScheduledDelivery?

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
}

/// Append-only (database trigger). Internal: never returned by an API.
model LedgerEntry {
  id            BigInt             @id @default(autoincrement())
  accountId     String             @db.Uuid
  account       CreditAccount      @relation(fields: [accountId], references: [id])
  grantId       String             @db.Uuid
  grant         CreditGrant        @relation(fields: [grantId], references: [id])
  reservationId String?            @db.Uuid
  reservation   CreditReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  kind          LedgerKind
  delta         Int
  reason        String?            @db.VarChar(80)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  @@index([accountId, createdAt])
  @@index([grantId])
  @@index([reservationId])
}

/// Survives account deletion. No user link, keyed hash only (HMAC with WELCOME_PEPPER, a secret used for nothing else).
model WelcomeGrantTombstone {
  emailHash String   @id @db.VarChar(64)
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
}

// ============================ Scheduling (Phase 2C.1) ============================
// Phase 2C.1 built the foundation; Phase 2C.2 adds the LINK delivery engine (src/modules/delivery) that moves SCHEDULED -> PROCESSING -> PUBLISHED,
// publishes the card and commits the reservation. Instants are timestamptz (UTC); the wall-clock the sender chose is kept as
// text next to the IANA zone so a user-visible time is never reinterpreted.

enum DeliveryChannel {
  /// The card becomes reachable at its private link at delivery time. The only channel implemented.
  LINK
  /// Reserved for a later phase (needs a provider, recipient consent handling and an unsubscribe path). Refused by the service today.
  EMAIL
}

enum ScheduleStatus {
  SCHEDULED
  PROCESSING
  /// The card is live at its link (LINK channel). Nothing is sent to the recipient: the sender shares the link.
  PUBLISHED
  CANCELLED
  FAILED
}

enum AttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  UNCERTAIN
  /// The worker's lease expired (crash or stall); the schedule was reconciled and returned to the queue.
  ABANDONED
}

enum ConsentStatus {
  NONE
  REQUESTED
  GRANTED
  WITHDRAWN
}

/// A person the owner sends cards to. Minimal on purpose: a name and a time zone; email is optional and unused until email delivery exists.
/// senderAttestedAt records what the SENDER says (they may contact this person). consentStatus is the RECIPIENT's own consent. They are
/// different facts and never interchangeable: only consentStatus = GRANTED may ever enable recipient-directed email.
model Recipient {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String         @db.Uuid
  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String         @db.VarChar(40)
  email            String?        @db.VarChar(254)
  timeZone         String         @default("UTC") @db.VarChar(64)
  senderAttestedAt DateTime?      @db.Timestamptz(3)
  consentStatus    ConsentStatus  @default(NONE)
  consentUpdatedAt DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  deliveries       ScheduledDelivery[]

  @@unique([ownerId, email])
  @@index([ownerId, createdAt])
}

model ScheduledDelivery {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Cascade: deleting an account removes its schedules. Held reservations must be released first (releaseAllHeld).
  ownerId          String            @db.Uuid
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cardId           String            @unique @db.Uuid
  card             Card              @relation(fields: [cardId], references: [id], onDelete: Restrict)
  recipientId      String?           @db.Uuid
  recipient        Recipient?        @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  channel          DeliveryChannel   @default(LINK)
  status           ScheduleStatus    @default(SCHEDULED)
  /// The actual instant (UTC).
  deliverAtUtc     DateTime          @db.Timestamptz(3)
  /// IANA zone the sender chose, with the local date/time they intended ("YYYY-MM-DD", "HH:mm") and the UTC offset that resolved it.
  timeZone         String            @db.VarChar(64)
  localDate        String            @db.VarChar(10)
  localTime        String            @db.VarChar(5)
  utcOffsetMinutes Int
  reservationId    String            @unique @db.Uuid
  reservation      CreditReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  idempotencyKey   String            @db.VarChar(64)
  requestHash      String            @db.VarChar(64)
  /// When a worker may next pick this up (equals deliverAtUtc until retries exist).
  nextAttemptAt    DateTime          @db.Timestamptz(3)
  attemptCount     Int               @default(0)
  /// attemptCount at the sender's last reschedule (0 = never). The retry budget counts attempts since then, capped by a lifetime maximum (docs/delivery.md).
  attemptBase      Int               @default(0)
  /// Optimistic concurrency token for reschedule.
  version          Int               @default(0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @db.Timestamptz(3)
  cancelledAt      DateTime?         @db.Timestamptz(3)
  publishedAt      DateTime?         @db.Timestamptz(3)
  failedAt         DateTime?         @db.Timestamptz(3)
  /// Queue lease. Set only while PROCESSING: leaseToken is the fencing token of the current claim; every worker write must match it.
  leaseToken       String?           @db.Uuid
  leaseOwner       String?           @db.VarChar(80)
  leaseExpiresAt   DateTime?         @db.Timestamptz(3)
  lastErrorCategory String?          @db.VarChar(40)
  attempts         DeliveryAttempt[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, status, deliverAtUtc])
}

/// Schema only in this phase: written by the future delivery worker.
model DeliveryAttempt {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId        String            @db.Uuid
  delivery          ScheduledDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNo         Int
  channel           DeliveryChannel
  status            AttemptStatus     @default(STARTED)
  startedAt         DateTime          @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime?         @db.Timestamptz(3)
  errorCode         String?           @db.VarChar(60)
  workerId          String?           @db.VarChar(80)
  /// Fencing token of the claim that made this attempt.
  leaseToken        String?           @db.Uuid
  errorCategory     String?           @db.VarChar(40)
  retryable         Boolean?
  retryAt           DateTime?         @db.Timestamptz(3)
  /// Provider reference for reconciliation (no message content, no addresses).
  providerRef       String?           @db.VarChar(120)

  @@unique([deliveryId, attemptNo])
}

/// Schema only: no reminder is sent in this phase.
model ReminderPreference {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  leadHours Int      @default(24)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Personal photo for a premium cinematic card (Phase 2E). Private by construction: the bytes are only ever served by /api/media/[id], which
/// checks ownership and the card's status. Metadata here; bytes in CardMediaBlob (so a blob store can replace it without touching this table).
enum MediaKind {
  IMAGE
}

model CardMedia {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @db.Uuid
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Null until the card is created in the same transaction that spends the credit; unattached rows are purged after 24 h.
  cardId      String?   @unique @db.Uuid
  card        Card?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind        MediaKind @default(IMAGE)
  contentType String    @db.VarChar(40)
  width       Int
  height      Int
  byteSize    Int
  sha256      String    @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  attachedAt  DateTime? @db.Timestamptz(3)
  blob        CardMediaBlob?

  @@index([ownerId, createdAt])
}

model CardMediaBlob {
  mediaId String    @id @db.Uuid
  media   CardMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  data    Bytes
}

// ============================ Marketing CMS (P5) ============================
// Document + revision store for site copy. Never stores HTML/scripts; payloads are typed JSON.
// Consumer reads publishedRevision only; drafts stay admin-only. Falls back to src/content/* when missing.

model CmsDocument {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable key: home.hero, home.sections, site.nav, site.footer, legal.privacy, legal.terms, seo.site
  key                  String        @unique @db.VarChar(80)
  title                String        @db.VarChar(160)
  /// Working draft JSON (validated by app schemas).
  draftPayload         Json
  /// Optimistic concurrency token for draft saves.
  draftVersion         Int           @default(1)
  publishedRevisionId  String?       @unique @db.Uuid
  publishedRevision    CmsRevision?  @relation("CmsPublishedPointer", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  publishedAt          DateTime?     @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedByStaffId     String?       @db.Uuid
  updatedByStaff       StaffPrincipal? @relation("CmsDocumentUpdatedBy", fields: [updatedByStaffId], references: [id], onDelete: SetNull)
  revisions            CmsRevision[] @relation("CmsDocumentRevisions")

  @@index([updatedAt])
}

model CmsRevision {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId         String       @db.Uuid
  document           CmsDocument  @relation("CmsDocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  revisionNumber     Int
  payload            Json
  note               String?      @db.VarChar(300)
  publishedAt        DateTime     @default(now()) @db.Timestamptz(3)
  publishedByStaffId String?      @db.Uuid
  publishedByStaff   StaffPrincipal? @relation("CmsRevisionPublishedBy", fields: [publishedByStaffId], references: [id], onDelete: SetNull)
  /// Back-relation when this revision is the live pointer.
  publishedFor       CmsDocument? @relation("CmsPublishedPointer")

  @@unique([documentId, revisionNumber])
  @@index([documentId, publishedAt])
}

// ============================ Marketing media library (P5C) ============================
// Public marketing assets only — never customer CardMedia. Bytes live on disk (local) / object storage (later);
// this table is metadata + CDN-ready public path. Soft-delete protects published CMS references.

enum CmsMarketingKind {
  IMAGE
  VIDEO
}

model CmsMarketingAsset {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             CmsMarketingKind
  title            String           @db.VarChar(160)
  altText          String           @db.VarChar(300)
  contentType      String           @db.VarChar(80)
  /// Relative storage key under the marketing media root (UUID-based; never a user path).
  storageKey       String           @unique @db.VarChar(200)
  /// Optional derivative thumbnail key (images only).
  thumbStorageKey  String?          @unique @db.VarChar(200)
  /// Display-only original basename (sanitised); never used for filesystem paths.
  originalFilename String           @db.VarChar(200)
  byteSize         Int
  width            Int?
  height           Int?
  durationMs       Int?
  sha256           String           @db.VarChar(64)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  uploadedByStaffId String?         @db.Uuid
  uploadedByStaff  StaffPrincipal?  @relation("CmsMarketingAssetUploadedBy", fields: [uploadedByStaffId], references: [id], onDelete: SetNull)
  /// Soft-delete: retained while published CMS revisions still reference the id.
  deletedAt        DateTime?        @db.Timestamptz(3)

  @@index([kind, createdAt])
  @@index([deletedAt, createdAt])
  @@index([title])
}
