generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CardStatus {
  PUBLISHED
  REMOVED
}

enum ReportReason {
  INAPPROPRIATE
  HARASSMENT
  SPAM
  OTHER
}

/// A published, personalised card. Template content lives in code (src/modules/templates).
model Card {
  id            String     @id @default(uuid()) @db.Uuid
  slug          String     @unique @db.VarChar(16)
  templateKey   String     @db.VarChar(40)
  recipientName String     @db.VarChar(40)
  senderName    String     @db.VarChar(40)
  message       String     @db.VarChar(500)
  status        CardStatus @default(PUBLISHED)
  createdAt     DateTime   @default(now())
  removedAt     DateTime?
  removedReason String?    @db.VarChar(200)
  reports       Report[]
  /// Nullable on purpose: historical and guest cards have no owner and are never auto-assigned one.
  /// SetNull (not Cascade/Restrict) so deleting an account can never delete or block public cards by accident;
  /// what happens to a deleted user's cards is an open product decision (docs/accounts.md).
  ownerId       String?    @db.Uuid
  owner         User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Resolved on the server from the template registry at publish time (never from the client); a snapshot, so
  /// reclassifying a template later does not rewrite history. Every existing card is STANDARD.
  tier          CardTier   @default(STANDARD)

  @@index([status, createdAt])
  @@index([ownerId])
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  cardId       String       @db.Uuid
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  reason       ReportReason
  details      String?      @db.VarChar(300)
  /// HMAC of the reporter IP, never the raw address.
  reporterHash String       @db.VarChar(64)
  createdAt    DateTime     @default(now())

  @@index([cardId])
}

/// Fixed-window counters keyed by HMAC(ip + scope). Rows expire and are purged (see rate-limit.ts).
model RateLimit {
  key         String   @id @db.VarChar(80)
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

// ============================ Accounts (Better Auth 1.7.19) ============================
// Table/column shapes for User, Session, Account, Verification and AuthRateLimit come from the Better Auth CLI
// (`npx auth@1.7.19 generate`, see docs/accounts.md). Deliberate edits: Timestamptz(3) on every timestamp, and the
// rate-limit model is renamed AuthRateLimit so it can never merge into Mawica's own RateLimit table.

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  settings      AccountSettings?
  cards         Card[]
  auditLogs     AuditLog[]
  creditAccount CreditAccount?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model AuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("authRateLimit")
}

// ---- Mawica-owned account data ----

model Profile {
  userId          String    @id @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String?   @db.VarChar(40)
  /// IANA zone id, validated server-side. Used later for scheduling; UTC until the user chooses.
  timeZone        String    @default("UTC") @db.VarChar(64)
  /// Time the sign-in notice (Terms and Privacy links) was shown and accepted by continuing. Not a legal-consent record.
  termsAcceptedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

/// Preferences with safe defaults. Nothing reads these yet (reminders arrive with scheduling).
model AccountSettings {
  userId         String   @id @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderEmails Boolean  @default(true)
  productNews    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

/// Append-only in spirit: application code only inserts. Never store emails, codes, tokens or message text in meta.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(60)
  meta      Json?
  /// HMAC of the client IP (same keyed hash scheme as rate limits), never the raw address.
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ============================ Card wallet (Phase 2B.2) ============================
// Design proven in the isolated spike (docs/wallet.md). Balances live in CreditGrant.remaining, guarded by CHECK
// constraints and updated only by conditional decrements inside a transaction; LedgerEntry is the append-only audit.
// All timestamps are timestamptz and the app connects in UTC (see src/lib/db.ts).

enum CardTier {
  STANDARD
  PREMIUM
}

enum EntitlementPeriod {
  NONE
  MONTH
  SUBSCRIPTION_YEAR
  LIFETIME
  EVENT
}

enum GrantUnit {
  TOTAL
  PREMIUM
}

enum GrantSource {
  WELCOME
  PLAN_PERIOD
  PURCHASE
  ADJUSTMENT
}

enum LedgerKind {
  GRANT
  RESERVE
  COMMIT
  RELEASE
  EXPIRE
  REFUND
  ADJUST
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
}

/// Plans are data. Corporate, Unlimited and Event are future rows (periods SUBSCRIPTION_YEAR / EVENT already exist).
model Plan {
  key          String            @id @db.VarChar(40)
  name         String            @db.VarChar(80)
  active       Boolean           @default(true)
  /// False until the payments phase: no client or API can put an account on a non-purchasable plan.
  purchasable  Boolean           @default(false)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  entitlements PlanEntitlement[]
  accounts     CreditAccount[]
}

/// key is one of: sends.total, sends.premium, welcome.premium, schedule.months_ahead (value NULL = unlimited, fair use applies).
model PlanEntitlement {
  planKey String            @db.VarChar(40)
  plan    Plan              @relation(fields: [planKey], references: [key], onDelete: Cascade)
  key     String            @db.VarChar(60)
  value   Int?
  period  EntitlementPeriod

  @@id([planKey, key])
}

model CreditAccount {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SetNull: deleting a user keeps the ledger (anonymised); the welcome tombstone is what stops a second gift.
  userId       String?             @unique @db.Uuid
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  planKey      String              @default("free") @db.VarChar(40)
  plan         Plan                @relation(fields: [planKey], references: [key])
  /// Fixed instant that anchors monthly periods (the account anniversary). Never changes.
  periodAnchor DateTime            @default(now()) @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  grants       CreditGrant[]
  reservations CreditReservation[]
  ledger       LedgerEntry[]
}

model CreditGrant {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String        @db.Uuid
  account   CreditAccount @relation(fields: [accountId], references: [id])
  unit      GrantUnit
  source    GrantSource
  /// Deterministic per logical grant ("welcome", "period:free:<start>:TOTAL", "purchase:<order>"), unique per account:
  /// retries are idempotent and many legitimate grants of one source can coexist.
  grantKey  String        @db.VarChar(100)
  amount    Int
  remaining Int
  validFrom DateTime      @db.Timestamptz(3)
  /// NULL = never expires (welcome gift).
  validTo   DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  ledger    LedgerEntry[]

  @@unique([accountId, grantKey])
  @@index([accountId, unit, validTo])
}

model CreditReservation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String            @db.Uuid
  account        CreditAccount     @relation(fields: [accountId], references: [id])
  idempotencyKey String            @db.VarChar(64)
  /// sha256 of the canonical request: same key + different hash is a client bug, refused.
  requestHash    String            @db.VarChar(64)
  status         ReservationStatus @default(HELD)
  premium        Boolean
  /// Plain id (no FK) on purpose: settled reservations are immutable, so a referential action must never need to update them.
  cardId         String?           @unique @db.Uuid
  deliverAt      DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  settledAt      DateTime?         @db.Timestamptz(3)
  ledger         LedgerEntry[]

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
}

/// Append-only (database trigger). Internal: never returned by an API.
model LedgerEntry {
  id            BigInt             @id @default(autoincrement())
  accountId     String             @db.Uuid
  account       CreditAccount      @relation(fields: [accountId], references: [id])
  grantId       String             @db.Uuid
  grant         CreditGrant        @relation(fields: [grantId], references: [id])
  reservationId String?            @db.Uuid
  reservation   CreditReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  kind          LedgerKind
  delta         Int
  reason        String?            @db.VarChar(80)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  @@index([accountId, createdAt])
  @@index([grantId])
  @@index([reservationId])
}

/// Survives account deletion. No user link, keyed hash only (HMAC with WELCOME_PEPPER, a secret used for nothing else).
model WelcomeGrantTombstone {
  emailHash String   @id @db.VarChar(64)
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
}
