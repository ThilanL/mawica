# Copy to .env.local. Fake values shown. Never commit real secrets.
DATABASE_URL="postgresql://mawica_app:CHANGE_ME@127.0.0.1:5433/mawica_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://mawica_app:CHANGE_ME@127.0.0.1:5433/mawica_dev_shadow?schema=public"
RATE_LIMIT_SALT="long-random-string"
ADMIN_TOKEN="long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Trusted reverse proxies in front of the app. 0 = ignore X-Forwarded-For (one shared rate-limit bucket).
# Azure App Service alone: 1. Front Door + App Service: 2. Verify on staging (docs/security.md).
TRUSTED_PROXY_HOPS=1
TEST_DATABASE_URL="postgresql://mawica_app:CHANGE_ME@127.0.0.1:5433/mawica_test?schema=public"

# Accounts (Better Auth). Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-64-hex-chars-from-openssl-rand-hex-32-xxxxxxxxxxxxxxxx"
# Defaults to NEXT_PUBLIC_SITE_URL. Must be https outside localhost (Secure cookies).
# BETTER_AUTH_URL="http://localhost:3000"
# Extra origins allowed to call auth endpoints in local dev (comma separated). Leave unset in production.
# AUTH_TRUSTED_ORIGINS="http://localhost:3010"
# Local mail transport only: file the one-time sign-in codes are appended to. No real email is sent.
# Defaults to .local-mail/outbox.jsonl outside production; must be set explicitly to be used in production builds.
# MAIL_LOCAL_OUTBOX=".local-mail/outbox.jsonl"

# Card wallet: secret for the one-time welcome-credit tombstone (HMAC of the verified email). Separate from every other secret.
# Generate with: openssl rand -hex 32. Never rotate it once real accounts exist.
WELCOME_PEPPER="replace-with-64-hex-chars-from-openssl-rand-hex-32-yyyyyyyyyyyyyyyyyyyy"
