{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "2.0.0.0",
  "metadata": {
    "description": "Mawica temporary STAGING on an Azure Free Trial, Australia East. Hosting: Azure Container Apps (Consumption workload profile only: no plan management fee, scale to zero) in a VNet-integrated environment, because the subscription's App Service quota is zero in Australia East and PostgreSQL is restricted in Australia Southeast. Database: PostgreSQL Flexible 17 B1ms in Southeast Asia (B1ms is not provisionable for this trial in Australia East), private access only in vnet-mawica-stg-sea (10.41.0.0/16), reached from Australia East over bidirectional Global VNet Peering; one private DNS zone linked to both VNets; no public endpoint. Synthetic test data only. Secrets only in Key Vault (RBAC), read by the app's user-assigned identity. Logs: Log Analytics capped at 0.2 GB/day. GitHub OIDC identity (federated credential, no client secret). The workload (database role secrets, migration and role jobs, the container app and GitHub's permissions) is in app.json, deployed only with approval. Budget AUD 60 with alerts at AUD 40/55. No App Service, Front Door, registry, storage account, private endpoints or premium SKUs."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "australiaeast"
    },
    "dbLocation": {
      "type": "string",
      "defaultValue": "southeastasia",
      "metadata": {
        "description": "PostgreSQL region. Southeast Asia because B1ms returned SkuNotAvailable in every Australia East zone for this Free Trial (2026-11-19). Synthetic test data only."
      }
    },
    "pgAdminLogin": {
      "type": "string",
      "defaultValue": "mawicaadmin"
    },
    "pgZone": {
      "type": "string",
      "defaultValue": "",
      "allowedValues": [
        "",
        "1",
        "2",
        "3"
      ],
      "metadata": {
        "description": "Pin PostgreSQL to an availability zone (B1ms capacity for trial subscriptions can be zone-specific). Empty: Azure chooses."
      }
    },
    "pgAdminPassword": {
      "type": "secureString",
      "metadata": {
        "description": "Generated by deploy.sh; never printed, logged or written to disk. Lands only in PostgreSQL and Key Vault."
      }
    },
    "betterAuthSecret": {
      "type": "secureString"
    },
    "welcomePepper": {
      "type": "secureString"
    },
    "rateLimitSalt": {
      "type": "secureString"
    },
    "githubRepo": {
      "type": "string",
      "defaultValue": "ThilanL/mawica"
    },
    "githubEnvironment": {
      "type": "string",
      "defaultValue": "staging"
    },
    "budgetAmountAud": {
      "type": "int",
      "defaultValue": 60
    },
    "budgetStartDate": {
      "type": "string",
      "defaultValue": "2026-11-01"
    }
  },
  "variables": {
    "suffix": "[take(uniqueString(resourceGroup().id), 5)]",
    "tags": {
      "app": "mawica",
      "env": "staging",
      "temporary": "true",
      "managedBy": "infra/staging/main.json"
    },
    "vnetName": "vnet-mawica-stg",
    "acaSubnet": "snet-aca",
    "dbSubnet": "snet-db",
    "dnsZone": "mawica-stg.private.postgres.database.azure.com",
    "dbVnetName": "vnet-mawica-stg-sea",
    "pgName": "[concat('psql-mawica-stg-', variables('suffix'))]",
    "kvName": "[concat('kv-mawica-stg-', variables('suffix'))]",
    "lawName": "log-mawica-stg",
    "envName": "cae-mawica-stg",
    "appName": "ca-mawica-stg",
    "appIdName": "id-mawica-stg-app",
    "ghIdName": "id-mawica-stg-github",
    "kvSecretsUser": "4633458b-17de-408a-b874-0445c86b69e6",
    "contributor": "b24988ac-6180-42a0-ab88-20f7382dd24c",
    "kvUri": "[concat('https://', variables('kvName'), '.vault.azure.net/secrets/')]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.40.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "[variables('acaSubnet')]",
            "properties": {
              "addressPrefix": "10.40.0.0/27",
              "delegations": [
                {
                  "name": "aca",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          },
          {
            "name": "[variables('dbSubnet')]",
            "properties": {
              "addressPrefix": "10.40.2.0/28",
              "delegations": [
                {
                  "name": "pg",
                  "properties": {
                    "serviceName": "Microsoft.DBforPostgreSQL/flexibleServers"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2024-06-01",
      "name": "[variables('dnsZone')]",
      "location": "global",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2024-06-01",
      "name": "[concat(variables('dnsZone'), '/link-', variables('vnetName'))]",
      "location": "global",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('dnsZone'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('dbVnetName')]",
      "location": "[parameters('dbLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.41.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "[variables('dbSubnet')]",
            "properties": {
              "addressPrefix": "10.41.2.0/28",
              "delegations": [
                {
                  "name": "pg",
                  "properties": {
                    "serviceName": "Microsoft.DBforPostgreSQL/flexibleServers"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[concat(variables('vnetName'), '/peer-to-sea')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('dbVnetName'))]"
      ],
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('dbVnetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[concat(variables('dbVnetName'), '/peer-to-aue')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('dbVnetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks/virtualNetworkPeerings', variables('vnetName'), 'peer-to-sea')]"
      ],
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2024-06-01",
      "name": "[concat(variables('dnsZone'), '/link-', variables('dbVnetName'))]",
      "location": "global",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('dnsZone'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('dbVnetName'))]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('dbVnetName'))]"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[variables('pgName')]",
      "location": "[parameters('dbLocation')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('dnsZone'), concat('link-', variables('vnetName')))]",
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('dnsZone'), concat('link-', variables('dbVnetName')))]",
        "[resourceId('Microsoft.Network/virtualNetworks/virtualNetworkPeerings', variables('dbVnetName'), 'peer-to-aue')]"
      ],
      "properties": {
        "version": "17",
        "availabilityZone": "[if(empty(parameters('pgZone')), json('null'), parameters('pgZone'))]",
        "administratorLogin": "[parameters('pgAdminLogin')]",
        "administratorLoginPassword": "[parameters('pgAdminPassword')]",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Disabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Disabled",
          "delegatedSubnetResourceId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('dbVnetName'), variables('dbSubnet'))]",
          "privateDnsZoneArmResourceId": "[resourceId('Microsoft.Network/privateDnsZones', variables('dnsZone'))]"
        },
        "authConfig": {
          "passwordAuth": "Enabled",
          "activeDirectoryAuth": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[concat(variables('pgName'), '/mawica')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName'))]"
      ],
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('lawName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "workspaceCapping": {
          "dailyQuotaGb": "0.2"
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('kvName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "enabledForDeployment": false,
        "enabledForTemplateDeployment": false,
        "enabledForDiskEncryption": false,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "defaultAction": "Allow",
          "bypass": "AzureServices"
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(variables('kvName'), '/database-url')]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName'))]"
      ],
      "properties": {
        "contentType": "postgres connection string (staging; admin role until a least-privilege mawica_app role exists)",
        "value": "[concat('postgresql://', parameters('pgAdminLogin'), ':', parameters('pgAdminPassword'), '@', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName')), '2024-08-01').fullyQualifiedDomainName, ':5432/mawica?sslmode=require')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(variables('kvName'), '/better-auth-secret')]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]"
      ],
      "properties": {
        "value": "[parameters('betterAuthSecret')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(variables('kvName'), '/welcome-pepper')]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]"
      ],
      "properties": {
        "value": "[parameters('welcomePepper')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(variables('kvName'), '/rate-limit-salt')]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]"
      ],
      "properties": {
        "value": "[parameters('rateLimitSalt')]"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('appIdName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('kvName')), variables('appIdName'), variables('kvSecretsUser'))]",
      "scope": "[concat('Microsoft.KeyVault/vaults/', variables('kvName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('appIdName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('kvSecretsUser'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('appIdName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('envName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('lawName'))]"
      ],
      "properties": {
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ],
        "vnetConfiguration": {
          "infrastructureSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('acaSubnet'))]",
          "internal": false
        },
        "zoneRedundant": false,
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('lawName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('lawName')), '2023-09-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('ghIdName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2023-01-31",
      "name": "[concat(variables('ghIdName'), '/github-', parameters('githubEnvironment'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ghIdName'))]"
      ],
      "properties": {
        "issuer": "https://token.actions.githubusercontent.com",
        "subject": "[concat('repo:', parameters('githubRepo'), ':environment:', parameters('githubEnvironment'))]",
        "audiences": [
          "api://AzureADTokenExchange"
        ]
      }
    },
    {
      "type": "Microsoft.Consumption/budgets",
      "apiVersion": "2023-05-01",
      "name": "budget-mawica-stg",
      "properties": {
        "category": "Cost",
        "amount": "[parameters('budgetAmountAud')]",
        "timeGrain": "Monthly",
        "timePeriod": {
          "startDate": "[parameters('budgetStartDate')]"
        },
        "notifications": {
          "actualAud40": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 66.67,
            "contactRoles": [
              "Owner"
            ],
            "thresholdType": "Actual"
          },
          "actualAud55": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 91.67,
            "contactRoles": [
              "Owner"
            ],
            "thresholdType": "Actual"
          },
          "forecastAud60": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 100,
            "contactRoles": [
              "Owner"
            ],
            "thresholdType": "Forecasted"
          }
        }
      }
    }
  ],
  "outputs": {
    "appName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "environment": {
      "type": "string",
      "value": "[variables('envName')]"
    },
    "postgresServer": {
      "type": "string",
      "value": "[variables('pgName')]"
    },
    "postgresFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgName')), '2024-08-01').fullyQualifiedDomainName]"
    },
    "keyVault": {
      "type": "string",
      "value": "[variables('kvName')]"
    },
    "githubClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ghIdName')), '2023-01-31').clientId]"
    },
    "appIdentity": {
      "type": "string",
      "value": "[variables('appIdName')]"
    }
  }
}
