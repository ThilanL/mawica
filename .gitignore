# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# generated prisma client
/src/generated/

# local mail transport outbox (contains one-time codes)
/.local-mail/

# local agent/validation artifacts (screenshots, logs)
/tmp/

# CMS marketing media bytes (metadata in Postgres; never customer CardMedia)
/storage/cms-marketing/

# Card music: only the three approved catalogue tracks are tracked.
/public/music/*.mp3
!/public/music/rise-and-shine.mp3
!/public/music/snowflakes-and-lights.mp3
!/public/music/snowlight-on-the-sleigh-path.mp3
