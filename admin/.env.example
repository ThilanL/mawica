# Mawica Admin (admin.mawica.com) — local / staging. Never commit real secrets.

# Same Mawica Postgres as the consumer app (local port 5433).
DATABASE_URL="postgresql://mawica_app:CHANGE_ME@127.0.0.1:5433/mawica_dev?schema=public"
RATE_LIMIT_SALT="long-random-string-shared-with-consumer-for-ip-hash-compat"

# Public URL of this admin app (canonical redirects + Secure cookies). Never derived from Host headers.
ADMIN_APP_URL="http://localhost:3010"
ADMIN_SESSION_SECRET="replace-with-64-hex-chars-from-openssl-rand-hex-32"

# Microsoft Entra ID (staff). Required when NODE_ENV=production (ACA).
# ADMIN_ENTRA_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# ADMIN_ENTRA_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# ADMIN_ENTRA_CLIENT_SECRET="from-key-vault-at-runtime"
# ADMIN_ENTRA_REDIRECT_URI="https://admin.mawica.com/api/auth/callback"

# Comma-separated allowlist. Required in production. Formats:
#   email:ROLE
#   entraOid:email:ROLE
# ADMIN_STAFF_ALLOWLIST="you@mawica.com:OWNER"

# Optional explicit extra browser origins (comma-separated). Do not populate from X-Forwarded-Host.
# ADMIN_TRUSTED_ORIGINS="https://admin.mawica.com"

# Behind Azure Container Apps ingress, set to 1 so X-Forwarded-For client IP is used for audit hashing.
# TRUSTED_PROXY_HOPS=1

# Local development only (forbidden when NODE_ENV=production — process will refuse to start):
# ADMIN_DEV_AUTH=1
# ADMIN_DEV_STAFF_EMAIL="dev.admin@mawica.local"
# ADMIN_DEV_STAFF_OID="local-dev-oid"
# ADMIN_DEV_STAFF_ROLE="OWNER"
