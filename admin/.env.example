# Mawica Admin (admin.mawica.com) — local / staging. Never commit real secrets.

# Same Mawica Postgres as the consumer app (local port 5433).
DATABASE_URL="postgresql://mawica_app:CHANGE_ME@127.0.0.1:5433/mawica_dev?schema=public"
RATE_LIMIT_SALT="long-random-string-shared-with-consumer-for-ip-hash-compat"

# Public URL of this admin app
ADMIN_APP_URL="http://localhost:3010"
ADMIN_SESSION_SECRET="replace-with-64-hex-chars-from-openssl-rand-hex-32"

# Microsoft Entra ID (staff). Leave unset to use local-dev auth only.
# ADMIN_ENTRA_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# ADMIN_ENTRA_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# ADMIN_ENTRA_CLIENT_SECRET="from-entra-app-registration"
# ADMIN_ENTRA_REDIRECT_URI="http://localhost:3010/api/auth/callback"

# Comma-separated allowlist. Formats:
#   email:ROLE
#   entraOid:email:ROLE
# ADMIN_STAFF_ALLOWLIST="you@mawica.com:OWNER"

# Local development only (never in staging/production):
# ADMIN_DEV_AUTH=1
# ADMIN_DEV_STAFF_EMAIL="dev.admin@mawica.local"
# ADMIN_DEV_STAFF_OID="local-dev-oid"
# ADMIN_DEV_STAFF_ROLE="OWNER"
